# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional server-only fallback. Configure in Vercel, never in VITE_* variables.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4.1-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Only completed Step 4 personnel records are stored in Firestore.
# Set these server-only variables in Vercel Production. Never commit a real key.
FIREBASE_PROJECT_ID="hrscan"
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"hrscan","client_email":"SERVICE_ACCOUNT_EMAIL","private_key":"PRIVATE_KEY"}'
