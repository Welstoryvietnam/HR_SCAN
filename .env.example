# OCR runs locally first. Optional Gemini assistance is disabled by default.
# For real personnel data, configure a Gemini project with Cloud Billing under
# Google's Paid Services terms. Calls may incur charges; enable explicitly.
GEMINI_OCR_ENABLED=false
GEMINI_API_KEY=""
GEMINI_OCR_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Only completed Step 4 personnel records are stored in Firestore.
# Set these server-only variables in Vercel Production. Never commit a real key.
FIREBASE_PROJECT_ID="hrscan"
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"hrscan","client_email":"SERVICE_ACCOUNT_EMAIL","private_key":"PRIVATE_KEY"}'
