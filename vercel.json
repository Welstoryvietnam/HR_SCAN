{
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": ["backend/ocrWorker.cjs", "node_modules/tesseract.js/src/**", "node_modules/tesseract.js-core/**", "node_modules/@tesseract.js-data/{vie,eng}/**"]
    }
  },
  "routes": [
    { "src": "/api(/.*)?", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
